# 複製成 .env 後再依環境調整;docker compose 會自動載入同目錄的 .env
# ---------- 模型 ----------
MODEL_REPO=Qwen/Qwen3.5-0.8B
MODEL_NAME=qwen3.5-0.8b
# 私有或受管制的權重才需要填,公開權重留空即可
HUGGING_FACE_HUB_TOKEN=

# ---------- 對外埠號 ----------
VLLM_PORT=8001
GATEWAY_PORT=8080
OPEN_WEBUI_PORT=3000

# ---------- vLLM(GPU 版)----------
VLLM_IMAGE_TAG=latest
# 注意:此值的可用上限取決於「容器內」可見的閒置顯存,不是宿主機 nvidia-smi 的數字
# 4GB 卡實測:容器內僅 3.22/4.0 GiB 可用,compose 內建 fallback 為 0.80,此處保守設為 0.78
VLLM_GPU_MEMORY_UTILIZATION=0.78
VLLM_MAX_MODEL_LEN=4096
# 限制並行序列數,避免 linear attention 的 recurrent state 佔滿 4GB 顯存
VLLM_MAX_NUM_SEQS=8
VLLM_CPU_LIMIT=4.0

# ---------- vLLM(CPU 版)----------
# x86_64 主機用 latest-x86_64;macOS Apple Silicon 與其他 ARM 主機改成 latest-arm64
VLLM_CPU_IMAGE_TAG=latest-x86_64
VLLM_DTYPE=bfloat16
VLLM_CPU_KVCACHE_SPACE=4
VLLM_MEMORY_LIMIT=8g

# ---------- Gateway ----------
LLM_API_KEY=EMPTY
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_READ_TIMEOUT=120
LOG_LEVEL=INFO

# ---------- Open WebUI ----------
OPEN_WEBUI_TAG=main
WEBUI_AUTH=false
# OpenAI 相容 base URL:預設留空即使用 compose 內網的 gateway 容器(http://gateway:8080/v1)
# 只有在 gateway 改跑於宿主機(例如 scripts\start-stack.ps1 開發模式)時,才需設為
# http://host.docker.internal:8080/v1
WEBUI_OPENAI_BASE_URL=
# 資源上限:WSL2 VM 總 7.569 GiB / 20 核;open-webui 閒置實測 1.065 GiB、0.70% CPU;
# vLLM 實測佔用 3.358 GiB(無記憶體上限)。2g+3.36g≈5.4g,尚留約 2.1g 給系統
OPEN_WEBUI_MEMORY_LIMIT=2g
OPEN_WEBUI_CPU_LIMIT=2.0

# ---------- 測試 ----------
SMOKE_TIMEOUT=180
